[Unit]
Description=jcsolution review API (gunicorn 127.0.0.1:8112)
After=network.target

[Service]
WorkingDirectory=/var/www/jcsolution_api
Environment=DB_PATH=/var/www/jcsolution_api/reviews.db
Environment=ADMIN_ID=admin
Environment=ADMIN_PW=1234
ExecStart=/var/www/jcsolution_api/venv/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:8112 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
